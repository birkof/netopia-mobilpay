{
    "name": "birkof/netopia-mobilpay",
    "description": "Mirroring MobilePay library with composer PSR-4 autoloading capability.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Daniel STANCU",
            "email": "birkof@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.3",
        "ext-dom": "*",
        "ext-openssl": "*"
    },
    "autoload": {
        "psr-4" : {
            "Mobilpay\\Payment\\" : "src/Mobilpay/Payment/"
        },
        "classmap": [
            "src/Mobilpay/Global.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11",
        "phpstan/phpstan": "^2"
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse"
    }
}
